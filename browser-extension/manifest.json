{
  "manifest_version": 3,

  "name": "Multimodal Fake Content Detector",

  "version": "1.0.0",

  "description": "Detect potentially fake or misleading text, images, and audio using a multimodal AI detection backend.",


  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting",
    "tabs"
  ],


  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",

    "http://*/*",
    "https://*/*"
  ],


  "action": {
    "default_title": "Multimodal Fake Content Detector",
    "default_popup": "popup.html"
  },


  "background": {
    "service_worker": "background.js"
  },


  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],

      "js": [
        "content.js"
      ],

      "run_at": "document_idle"
    }
  ]
}